  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@playwright/test": "^1.64.1",
    "eslint": "^9.37.0",
    "eslint-plugin-jsdoc": "^65.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.4.0",
    "jiti": "^2.6.0",
    "pdf-lib": "^1.17.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0"
  }
}
